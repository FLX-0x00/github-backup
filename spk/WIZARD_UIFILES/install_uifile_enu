[
    {
        "step_title": "GitHub access",
        "invalid_next_disabled": true,
        "items": [
            {
                "desc": "This package mirrors every repository the token can access as bare Git mirrors. A <b>classic token</b> with the <b>repo</b> and <b>read:org</b> scopes covers all personal accounts and organizations in one run. Fine-grained tokens only cover <b>one</b> owner (a user or one organization); add more connections via the CLI after installation."
            },
            {
                "type": "password",
                "subitems": [
                    {
                        "key": "wizard_token",
                        "desc": "Personal access token",
                        "validator": {
                            "allowBlank": false,
                            "minLength": 20
                        }
                    }
                ]
            },
            {
                "type": "combobox",
                "subitems": [
                    {
                        "key": "wizard_kind",
                        "desc": "Token type",
                        "editable": false,
                        "defaultValue": "Classic (all accounts/orgs)",
                        "store": [
                            "Classic (all accounts/orgs)",
                            "Fine-grained (one user)",
                            "Fine-grained (one org)"
                        ]
                    }
                ]
            },
            {
                "type": "textfield",
                "subitems": [
                    {
                        "key": "wizard_owner",
                        "desc": "Owner/org (fine-grained org only)",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true,
                            "regex": {
                                "expr": "/^[A-Za-z0-9_.-]*$/",
                                "errorText": "Only letters, numbers, dot, dash and underscore."
                            }
                        }
                    }
                ]
            }
        ]
    },
    {
        "step_title": "Target and schedule",
        "invalid_next_disabled": true,
        "items": [
            {
                "type": "textfield",
                "subitems": [
                    {
                        "key": "wizard_storage",
                        "desc": "Storage path (absolute; use e.g. /volume2/backup/github on another volume). The backup share is created automatically on first start (or granted to sc-github-backup); backup/github is created inside it. A different path outside backup needs manual permissions.",
                        "defaultValue": "/volume1/backup/github",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/.*$/",
                                "errorText": "Please enter an absolute path."
                            }
                        }
                    }
                ]
            },
            {
                "type": "combobox",
                "subitems": [
                    {
                        "key": "wizard_weekday",
                        "desc": "Weekday",
                        "editable": false,
                        "defaultValue": "Sunday",
                        "store": [
                            "Sunday",
                            "Monday",
                            "Tuesday",
                            "Wednesday",
                            "Thursday",
                            "Friday",
                            "Saturday"
                        ]
                    }
                ]
            },
            {
                "type": "textfield",
                "subitems": [
                    {
                        "key": "wizard_hour",
                        "desc": "Hour (0-23)",
                        "defaultValue": "3",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^([01]?[0-9]|2[0-3])$/",
                                "errorText": "Hour must be between 0 and 23."
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "subitems": [
                    {
                        "key": "wizard_minute",
                        "desc": "Minute (0-59)",
                        "defaultValue": "0",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^([0-5]?[0-9])$/",
                                "errorText": "Minute must be between 0 and 59."
                            }
                        }
                    }
                ]
            },
            {
                "type": "multiselect",
                "subitems": [
                    {
                        "key": "wizard_schedule",
                        "desc": "Enable weekly schedule",
                        "defaultValue": true
                    },
                    {
                        "key": "wizard_wikis",
                        "desc": "Include wikis",
                        "defaultValue": true
                    },
                    {
                        "key": "wizard_prune",
                        "desc": "Prune branches deleted upstream",
                        "defaultValue": false
                    },
                    {
                        "key": "wizard_notify",
                        "desc": "Send DSM notification after each run",
                        "defaultValue": true
                    }
                ]
            },
            {
                "type": "textfield",
                "subitems": [
                    {
                        "key": "wizard_repos",
                        "desc": "Optional: only these repositories (comma-separated, empty = all incl. new)",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true
                        }
                    }
                ]
            }
        ]
    },
    {
        "step_title": "Done",
        "items": [
            {
                "desc": "After installation the service starts and runs the first backup. Progress is written to <b>logs/</b> below the storage path and to DSM notifications. More connections and repository selection can be managed later over SSH with <b>github-backup add-connection</b> and <b>github-backup select</b>."
            }
        ]
    }
]
