#!/bin/sh
set -u

PKG_NAME="github-backup"
TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG_NAME/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG_NAME/var}"
BIN="$TARGET/bin/github-backup"
PIDFILE="$VAR/daemon.pid"
LOGFILE="$VAR/daemon.log"
INSTALL="$VAR/install"
HOME="$VAR/home"
export HOME

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

install_config() {
    [ -d "$INSTALL" ] || return 0
    [ -s "$VAR/config.json" ] && return 0

    token=$(cat "$INSTALL/token" 2>/dev/null || true)
    kind=$(cat "$INSTALL/kind" 2>/dev/null || true)
    owner=$(cat "$INSTALL/owner" 2>/dev/null || true)
    storage=$(cat "$INSTALL/storage" 2>/dev/null || true)
    repos=$(cat "$INSTALL/repos" 2>/dev/null || true)
    weekday=$(cat "$INSTALL/weekday" 2>/dev/null || true)
    hour=$(cat "$INSTALL/hour" 2>/dev/null || true)
    minute=$(cat "$INSTALL/minute" 2>/dev/null || true)
    wikis=$(cat "$INSTALL/wikis" 2>/dev/null || true)
    prune=$(cat "$INSTALL/prune" 2>/dev/null || true)
    notify=$(cat "$INSTALL/notify" 2>/dev/null || true)
    schedule=$(cat "$INSTALL/schedule" 2>/dev/null || true)
    api_base=$(cat "$INSTALL/api_base" 2>/dev/null || true)

    [ -n "$token" ] || { echo "FEHLER: Kein Token in $INSTALL/token" >>"$LOGFILE"; return 1; }
    [ -n "$storage" ] || { echo "FEHLER: Kein Speicherort in $INSTALL/storage" >>"$LOGFILE"; return 1; }
    [ -n "$api_base" ] || api_base="https://api.github.com"
    [ -n "$weekday" ] || weekday=0
    [ -n "$hour" ] || hour=3
    [ -n "$minute" ] || minute=0
    [ -n "$wikis" ] || wikis=true
    [ -n "$prune" ] || prune=false
    [ -n "$notify" ] || notify=true
    [ -n "$schedule" ] || schedule=true

    SCHEDULE_FLAG=""
    [ "$schedule" = "true" ] || SCHEDULE_FLAG="--no-schedule"

    # The data-share worker grants the package user rw on the "backup" share.
    # Give DSM a moment if the resource is still being applied.
    i=0
    while [ "$i" -lt 10 ]; do
        [ -d "$storage" ] && [ -w "$storage" ] && break
        [ -d "$(dirname "$storage")" ] && [ -w "$(dirname "$storage")" ] && break
        sleep 1
        i=$((i + 1))
    done

    echo "Lege Konfiguration an: $VAR/config.json" >>"$LOGFILE"
    GITHUB_TOKEN="$token" "$BIN" init \
        --config "$VAR/config.json" \
        --data-root "$storage" \
        --api-base "$api_base" \
        --kind "$kind" \
        --owner "$owner" \
        --weekday "$weekday" \
        --hour "$hour" \
        --minute "$minute" \
        --repos "$repos" \
        --wikis="$wikis" \
        --prune="$prune" \
        --notify="$notify" \
        $SCHEDULE_FLAG >>"$LOGFILE" 2>&1
    rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "FEHLER: Konfiguration konnte nicht angelegt werden (rc=$rc)." >>"$LOGFILE"
        return 1
    fi
    rm -rf "$INSTALL"
    return 0
}

start() {
    mkdir -p "$VAR" 2>/dev/null || return 1
    chmod 700 "$VAR" 2>/dev/null || true
    mkdir -p "$HOME" 2>/dev/null || return 1
    chmod 700 "$HOME" 2>/dev/null || true

    if is_running; then
        return 0
    fi

    [ -x "$BIN" ] || return 1
    install_config || return 1
    [ -r "$VAR/config.json" ] || return 1

    "$BIN" daemon --config "$VAR/config.json" --pidfile "$PIDFILE" >>"$LOGFILE" 2>&1 &
    sleep 1
    if is_running; then
        return 0
    fi
    return 1
}

stop() {
    if ! is_running; then
        rm -f "$PIDFILE"
        return 0
    fi
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    kill "$pid" 2>/dev/null || true
    i=0
    while [ "$i" -lt 15 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
    return 0
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    prestart|prestop)
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
